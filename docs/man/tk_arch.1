.nh
.TH "true-knowledge" "1" "Sep 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-arch - Architecture brief (languages, packages, entry points, hotspots)


.SH SYNOPSIS
\fBtk arch [--project ] [flags]\fP


.SH DESCRIPTION
Architecture brief (languages, packages, entry points, hotspots)


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for arch

.PP
\fB--project\fP=""
	project name


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent: config+data+cache+state under it)

.PP
\fB--json\fP[=false]
	stable JSON envelope output


.SH SEE ALSO
\fBtk(1)\fP
