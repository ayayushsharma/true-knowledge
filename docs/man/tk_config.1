.TH "true-knowledge" "1" "Sep 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-config - Inspect/change tk config (tk owns, CBM follows via env)


.SH SYNOPSIS
\fBtk config [flags]\fP


.SH DESCRIPTION
Inspect/change tk config (tk owns, CBM follows via env)


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for config


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent: config+data+cache+state under it)

.PP
\fB--json\fP[=false]
	stable JSON envelope output


.SH SEE ALSO
\fBtk(1)\fP, \fBtk-config-get(1)\fP, \fBtk-config-list(1)\fP, \fBtk-config-reset(1)\fP, \fBtk-config-set(1)\fP, \fBtk-config-validate(1)\fP
