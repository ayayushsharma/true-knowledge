.SH NAME
tk-daemon-stop - cbm daemon stop


.SH SYNOPSIS
\fBtk daemon stop [flags]\fP


.SH DESCRIPTION
cbm daemon stop


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for stop


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent: config+data+cache+state under it)

.PP
\fB--json\fP[=false]
	stable JSON envelope output


.SH SEE ALSO
\fBtk-daemon(1)\fP
