.nh
.TH "true-knowledge" "1" "Sep 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-explain - Definition + snippet + callers/callees (one bounded call set)


.SH SYNOPSIS
\fBtk explain --symbol  [--project ] [flags]\fP


.SH DESCRIPTION
Definition + snippet + callers/callees (one bounded call set)


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for explain

.PP
\fB--project\fP=""
	project name

.PP
\fB-s\fP, \fB--select\fP[=false]
	force the interactive project picker open (ignored when --project is set)

.PP
\fB--symbol\fP=""
	qualified symbol name


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent: config+data+cache+state under it)

.PP
\fB--json\fP[=false]
	stable JSON envelope output


.SH SEE ALSO
\fBtk(1)\fP
