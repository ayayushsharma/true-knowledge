.nh
.TH "true-knowledge" "1" "Sep 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-find - Deterministic router: regex→grep, NL→semantic, ident→graph


.SH SYNOPSIS
\fBtk find  [project] [flags]\fP


.SH DESCRIPTION
Deterministic router: regex→grep, NL→semantic, ident→graph


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for find

.PP
\fB--label\fP=""
	node-label filter (graph routes only)

.PP
\fB--limit\fP=20
	max results

.PP
\fB--project\fP=""
	project name


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent: config+data+cache+state under it)

.PP
\fB--json\fP[=false]
	stable JSON envelope output


.SH EXAMPLE
.EX
  tk find ProcessOrder demo
  tk find "retry.*backoff" demo --limit 20
  tk find Handler demo --label Function
.EE


.SH SEE ALSO
\fBtk(1)\fP
