.nh
.TH "true-knowledge" "1" "Oct 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-find - Deterministic router: single-token→own index, ident→graph


.SH SYNOPSIS
\fBtk find --query  [--project ] [flags]\fP


.SH DESCRIPTION
Deterministic router: single-token→own index, ident→graph


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for find

.PP
\fB--label\fP=""
	node-label filter (graph routes only)

.PP
\fB--limit\fP=20
	max results

.PP
\fB--project\fP=""
	project name

.PP
\fB--query\fP=""
	identifier, natural-language phrase, or text pattern

.PP
\fB-s\fP, \fB--select\fP[=false]
	open the interactive project picker (ignored when --project is set)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent)

.PP
\fB--json\fP[=false]
	stable JSON envelope output

.PP
\fB--quiet\fP[=false]
	errors only on stderr; suppress progress

.PP
\fB--verbose\fP[=false]
	debug narration on stderr


.SH EXAMPLE
.EX
  tk find --query ProcessOrder --project demo
  tk find --query internal/cli/query.go --project demo
.EE


.SH SEE ALSO
\fBtk(1)\fP
