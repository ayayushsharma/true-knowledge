.nh
.TH "true-knowledge" "1" "Sep 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-impact - Map working-tree diff to affected symbols + blast radius


.SH SYNOPSIS
\fBtk impact [--project ] [flags]\fP


.SH DESCRIPTION
Map working-tree diff to affected symbols + blast radius


.SH OPTIONS
\fB--depth\fP=2
	traversal depth

.PP
\fB--direction\fP="inbound"
	inbound|outbound|both

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for impact

.PP
\fB--limit\fP=50
	max rows

.PP
\fB--project\fP=""
	project name

.PP
\fB-s\fP, \fB--select\fP[=false]
	force the interactive project picker open (ignored when --project is set)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent: config+data+cache+state under it)

.PP
\fB--json\fP[=false]
	stable JSON envelope output


.SH EXAMPLE
.EX
  tk impact --project demo
  tk impact --direction outbound --depth 3 --project demo
.EE


.SH SEE ALSO
\fBtk(1)\fP
