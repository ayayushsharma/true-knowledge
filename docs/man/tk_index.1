.nh
.TH "true-knowledge" "1" "Sep 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-index - Index a project via CBM (default: moderate)


.SH SYNOPSIS
\fBtk index [project] [flags]\fP


.SH DESCRIPTION
Index a project via CBM (default: moderate)


.SH OPTIONS
\fB--fast\fP[=false]
	shorthand for --mode fast

.PP
\fB--full\fP[=false]
	shorthand for --mode full

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for index

.PP
\fB--mode\fP=""
	fast|moderate|full


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent: config+data+cache+state under it)

.PP
\fB--json\fP[=false]
	stable JSON envelope output


.SH EXAMPLE
.EX
  tk index demo
  tk index demo --full
  tk index  # all registered
.EE


.SH SEE ALSO
\fBtk(1)\fP
