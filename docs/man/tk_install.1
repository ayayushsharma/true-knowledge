.nh
.TH "true-knowledge" "1" "Sep 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-install - Install/update managed indexing backends (default: all)


.SH SYNOPSIS
\fBtk install [backend...] [flags]\fP


.SH DESCRIPTION
Installs missing backends and updates stale ones to their pins.
Backends live in /bin (== CBM_CACHE_DIR/bin); checksums verified before any write.
Adding a backend is one entry in internal/backends — see docs/DECISIONS.


.SH OPTIONS
\fB--check\fP[=false]
	report status only, no network

.PP
\fB--dry-run\fP[=false]
	print plan URLs without downloading

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for install

.PP
\fB--update\fP[=false]
	reinstall even when up-to-date (downgrade-safe)

.PP
\fB--version\fP=""
	override pin X.Y.Z for this run (persists to config)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent: config+data+cache+state under it)

.PP
\fB--json\fP[=false]
	stable JSON envelope output


.SH EXAMPLE
.EX
  tk install                  # install all missing backends
  tk install cbm --update     # (re)install cbm at its pin
  tk install --check          # report only, no network
  tk install cbm --version 0.12.0 --dry-run
.EE


.SH SEE ALSO
\fBtk(1)\fP
