.nh
.TH "true-knowledge" "1" "Oct 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-install - Install/update managed indexing backends (default: all)


.SH SYNOPSIS
\fBtk install [backend...] [flags]\fP


.SH DESCRIPTION
Installs missing backends and updates stale ones to their pins.
Checksums verified before any write; a daemon with live sessions refuses to stop — close them, then retry.


.SH OPTIONS
\fB--check\fP[=false]
	report status only, no network

.PP
\fB--dry-run\fP[=false]
	print plan URLs without downloading

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for install

.PP
\fB--update\fP[=false]
	reinstall even when up-to-date (downgrade-safe)

.PP
\fB--version\fP=""
	override pin X.Y.Z for this run (persists to config)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent)

.PP
\fB--json\fP[=false]
	stable JSON envelope output

.PP
\fB--quiet\fP[=false]
	errors only on stderr; suppress progress

.PP
\fB--verbose\fP[=false]
	debug narration on stderr


.SH EXAMPLE
.EX
  tk install                  # install all missing backends
  tk install cbm --update     # (re)install cbm at its pin
.EE


.SH SEE ALSO
\fBtk(1)\fP
