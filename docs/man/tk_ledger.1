.nh
.TH "true-knowledge" "1" "Sep 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-ledger - Per-project working truths (append-only, five keys, history, human-only prune)


.SH SYNOPSIS
\fBtk ledger [flags]\fP


.SH DESCRIPTION
Per-project working truths (append-only, five keys, history, human-only prune)


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for ledger


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent: config+data+cache+state under it)

.PP
\fB--json\fP[=false]
	stable JSON envelope output

.PP
\fB--quiet\fP[=false]
	stderr carries errors only; suppress progress (TK_LOG=error)

.PP
\fB--verbose\fP[=false]
	debug narration on stderr (TK_LOG=debug)


.SH SEE ALSO
\fBtk(1)\fP, \fBtk-ledger-get(1)\fP, \fBtk-ledger-history(1)\fP, \fBtk-ledger-prune(1)\fP, \fBtk-ledger-update(1)\fP
