.TH "true-knowledge" "1" "Sep 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-ledger - Per-project working truth blobs (bounded, full-text replace)


.SH SYNOPSIS
\fBtk ledger [flags]\fP


.SH DESCRIPTION
Per-project working truth blobs (bounded, full-text replace)


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for ledger


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent: config+data+cache+state under it)

.PP
\fB--json\fP[=false]
	stable JSON envelope output


.SH SEE ALSO
\fBtk(1)\fP, \fBtk-ledger-get(1)\fP, \fBtk-ledger-update(1)\fP
