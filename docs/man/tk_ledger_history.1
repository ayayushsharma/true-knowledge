.nh
.TH "true-knowledge" "1" "Oct 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-ledger-history - Complete ledger log: every entry, chronological, uncapped (the audit trail)


.SH SYNOPSIS
\fBtk ledger history  [flags]\fP


.SH DESCRIPTION
Complete ledger log: every entry, chronological, uncapped (the audit trail)


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for history


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent)

.PP
\fB--json\fP[=false]
	stable JSON envelope output

.PP
\fB--quiet\fP[=false]
	errors only on stderr; suppress progress

.PP
\fB--verbose\fP[=false]
	debug narration on stderr


.SH EXAMPLE
.EX
  tk ledger history demo
.EE


.SH SEE ALSO
\fBtk-ledger(1)\fP
