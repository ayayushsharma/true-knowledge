.nh
.TH "true-knowledge" "1" "Oct 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-ledger-prune - Delete a project ledger permanently — interactive TTY confirmation only (no MCP tool; humans-only)


.SH SYNOPSIS
\fBtk ledger prune  [flags]\fP


.SH DESCRIPTION
Delete a project ledger permanently — interactive TTY confirmation only (no MCP tool; humans-only)


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for prune


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent)

.PP
\fB--json\fP[=false]
	stable JSON envelope output

.PP
\fB--quiet\fP[=false]
	errors only on stderr; suppress progress

.PP
\fB--verbose\fP[=false]
	debug narration on stderr


.SH EXAMPLE
.EX
  tk ledger prune demo
.EE


.SH SEE ALSO
\fBtk-ledger(1)\fP
