.nh
.TH "true-knowledge" "1" "Sep 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-mcp - Run MCP stdio proxy (profile: scout|analysis|minimal|memory), stdin EOF = instant exit


.SH SYNOPSIS
\fBtk mcp [flags]\fP


.SH DESCRIPTION
Run MCP stdio proxy (profile: scout|analysis|minimal|memory), stdin EOF = instant exit


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for mcp

.PP
\fB--tool-profile\fP="scout"
	tool surface: scout (11) | analysis (14) | minimal (3) | memory (20); explicit flag beats TK_MCP_PROFILE and config mcp.profile


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent: config+data+cache+state under it)

.PP
\fB--json\fP[=false]
	stable JSON envelope output


.SH SEE ALSO
\fBtk(1)\fP
