.nh
.TH "true-knowledge" "1" "Sep 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-mem - Durable scoped facts (tk-owned memory, never needs CBM)


.SH SYNOPSIS
\fBtk mem [flags]\fP


.SH DESCRIPTION
Durable scoped facts (tk-owned memory, never needs CBM)


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for mem


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent: config+data+cache+state under it)

.PP
\fB--json\fP[=false]
	stable JSON envelope output


.SH SEE ALSO
\fBtk(1)\fP, \fBtk-mem-recall(1)\fP, \fBtk-mem-review(1)\fP, \fBtk-mem-save(1)\fP
