.nh
.TH "true-knowledge" "1" "Sep 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-note - Capture/search project notes (tk-owned, review-gated, never needs CBM)


.SH SYNOPSIS
\fBtk note [flags]\fP


.SH DESCRIPTION
Capture/search project notes (tk-owned, review-gated, never needs CBM)


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for note


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent: config+data+cache+state under it)

.PP
\fB--json\fP[=false]
	stable JSON envelope output


.SH SEE ALSO
\fBtk(1)\fP, \fBtk-note-reindex(1)\fP, \fBtk-note-review(1)\fP, \fBtk-note-save(1)\fP, \fBtk-note-search(1)\fP, \fBtk-note-toc(1)\fP
