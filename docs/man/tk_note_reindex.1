.nh
.TH "true-knowledge" "1" "Sep 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-note-reindex - Rebuild FTS index from the markdown sources of truth


.SH SYNOPSIS
\fBtk note reindex [project] [flags]\fP


.SH DESCRIPTION
Rebuild FTS index from the markdown sources of truth


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for reindex

.PP
\fB--project\fP=""
	limit to one project (or pass as arg)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent: config+data+cache+state under it)

.PP
\fB--json\fP[=false]
	stable JSON envelope output


.SH SEE ALSO
\fBtk-note(1)\fP
