.nh
.TH "true-knowledge" "1" "Sep 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-note-review - Approve/reject captured notes


.SH SYNOPSIS
\fBtk note review [flags]\fP


.SH DESCRIPTION
Approve/reject captured notes


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for review


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent: config+data+cache+state under it)

.PP
\fB--json\fP[=false]
	stable JSON envelope output


.SH SEE ALSO
\fBtk-note(1)\fP, \fBtk-note-review-approve(1)\fP, \fBtk-note-review-list(1)\fP, \fBtk-note-review-reject(1)\fP
