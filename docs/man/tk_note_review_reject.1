.TH "true-knowledge" "1" "Sep 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-note-review-reject - Drop one captured note (nothing written/indexed)


.SH SYNOPSIS
\fBtk note review reject  [flags]\fP


.SH DESCRIPTION
Drop one captured note (nothing written/indexed)


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for reject


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent: config+data+cache+state under it)

.PP
\fB--json\fP[=false]
	stable JSON envelope output


.SH SEE ALSO
\fBtk-note-review(1)\fP
