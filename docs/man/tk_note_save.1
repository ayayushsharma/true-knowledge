.nh
.TH "true-knowledge" "1" "Oct 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-note-save - Capture a note into the review queue (searchable after approval)


.SH SYNOPSIS
\fBtk note save  [flags]\fP


.SH DESCRIPTION
Capture a note into the review queue (searchable after approval)


.SH OPTIONS
\fB--body\fP=""
	file whose contents become the note body

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for save

.PP
\fB--project\fP=""
	project name (required)

.PP
\fB--text\fP=""
	inline note body


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent)

.PP
\fB--json\fP[=false]
	stable JSON envelope output

.PP
\fB--quiet\fP[=false]
	errors only on stderr; suppress progress

.PP
\fB--verbose\fP[=false]
	debug narration on stderr


.SH EXAMPLE
.EX
  tk note save "deploy cadence" --text "releases ship weekly" --project demo
  tk note save "incident" --body ./postmortem.md --project demo
.EE


.SH SEE ALSO
\fBtk-note(1)\fP
