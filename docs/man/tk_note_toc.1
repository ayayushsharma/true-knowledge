.nh
.TH "true-knowledge" "1" "Sep 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-note-toc - List note titles only, budgeted (never bodies)


.SH SYNOPSIS
\fBtk note toc [flags]\fP


.SH DESCRIPTION
List note titles only, budgeted (never bodies)


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for toc

.PP
\fB--project\fP=""
	limit to one project


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent: config+data+cache+state under it)

.PP
\fB--json\fP[=false]
	stable JSON envelope output


.SH SEE ALSO
\fBtk-note(1)\fP
