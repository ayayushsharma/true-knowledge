.nh
.TH "true-knowledge" "1" "Sep 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-query - Raw read-only graph query (analysis profile)


.SH SYNOPSIS
\fBtk query  [project] [flags]\fP


.SH DESCRIPTION
Raw read-only graph query (analysis profile)


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for query

.PP
\fB--limit\fP=20
	row limit guardrail

.PP
\fB--project\fP=""
	project name


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent: config+data+cache+state under it)

.PP
\fB--json\fP[=false]
	stable JSON envelope output


.SH EXAMPLE
.EX
  tk query "MATCH (f:Function) RETURN f.name LIMIT 5" demo
.EE


.SH SEE ALSO
\fBtk(1)\fP
