.nh
.TH "true-knowledge" "1" "Oct 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-register - Register a repo path (no auto-index)


.SH SYNOPSIS
\fBtk register  [flags]\fP


.SH DESCRIPTION
Register a repo path (no auto-index)


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for register

.PP
\fB--name\fP=""
	project name (default: directory base)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent)

.PP
\fB--json\fP[=false]
	stable JSON envelope output

.PP
\fB--quiet\fP[=false]
	errors only on stderr; suppress progress

.PP
\fB--verbose\fP[=false]
	debug narration on stderr


.SH EXAMPLE
.EX
  tk register ./myrepo --name demo
.EE


.SH SEE ALSO
\fBtk(1)\fP
