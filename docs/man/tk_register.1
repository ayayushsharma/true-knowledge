.nh
.TH "true-knowledge" "1" "Sep 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-register - Register a repo path (no auto-index)


.SH SYNOPSIS
\fBtk register  [flags]\fP


.SH DESCRIPTION
Register a repo path (no auto-index)


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for register

.PP
\fB--name\fP=""
	project name (default: directory base)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent: config+data+cache+state under it)

.PP
\fB--json\fP[=false]
	stable JSON envelope output


.SH EXAMPLE
.EX
  tk register ./myrepo --name demo
  tk register /abs/path
.EE


.SH SEE ALSO
\fBtk(1)\fP
