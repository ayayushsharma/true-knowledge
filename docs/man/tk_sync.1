.nh
.TH "true-knowledge" "1" "Oct 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-sync - Fast no-op on clean Git HEAD, else delegate to watcher/index


.SH SYNOPSIS
\fBtk sync [project] [flags]\fP


.SH DESCRIPTION
Fast no-op on clean Git HEAD, else delegate to watcher/index


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for sync


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent)

.PP
\fB--json\fP[=false]
	stable JSON envelope output

.PP
\fB--quiet\fP[=false]
	errors only on stderr; suppress progress

.PP
\fB--verbose\fP[=false]
	debug narration on stderr


.SH EXAMPLE
.EX
  tk sync demo
  tk sync  # all
.EE


.SH SEE ALSO
\fBtk(1)\fP
