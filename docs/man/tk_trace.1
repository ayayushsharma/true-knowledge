.nh
.TH "true-knowledge" "1" "Sep 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-trace - BFS callers/callees of one symbol (who calls it / what it calls)


.SH SYNOPSIS
\fBtk trace --symbol  [--project ] [flags]\fP


.SH DESCRIPTION
BFS callers/callees of one symbol (who calls it / what it calls)


.SH OPTIONS
\fB--depth\fP=1
	traversal depth 1-5

.PP
\fB--direction\fP="inbound"
	inbound=callers, outbound=callees, both

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for trace

.PP
\fB--project\fP=""
	project name

.PP
\fB-s\fP, \fB--select\fP[=false]
	force the interactive project picker open (ignored when --project is set)

.PP
\fB--symbol\fP=""
	symbol to trace (callers by default)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent: config+data+cache+state under it)

.PP
\fB--json\fP[=false]
	stable JSON envelope output


.SH EXAMPLE
.EX
  tk trace --symbol ProcessOrder --project demo
  tk trace --symbol ProcessOrder --direction outbound --depth 3 --project demo
.EE


.SH SEE ALSO
\fBtk(1)\fP
