.nh
.TH "true-knowledge" "1" "Sep 2026" "true-knowledge" "tk (true-knowledge)"

.SH NAME
tk-validate - Symbol existence + near-miss candidates, coverage-annotated (analysis profile)


.SH SYNOPSIS
\fBtk validate  [project] [flags]\fP


.SH DESCRIPTION
Symbol existence + near-miss candidates, coverage-annotated (analysis profile)


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for validate

.PP
\fB--limit\fP=5
	max rows per lookup

.PP
\fB--project\fP=""
	project name


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--budget\fP=0
	char budget override (0 = config defaults)

.PP
\fB--home\fP=""
	override base home (TK_HOME equivalent: config+data+cache+state under it)

.PP
\fB--json\fP[=false]
	stable JSON envelope output


.SH EXAMPLE
.EX
  tk validate ProcessOrder demo
.EE


.SH SEE ALSO
\fBtk(1)\fP
